import { Theme } from "../theme.slint";
import { Button } from "../common/buttons.slint";
import { ComboBoxField } from "../common/combo-box.slint";
import { TextField } from "../common/text-field.slint";
import { LabeledField } from "../common/labeled-field.slint";
import { PresetPickerButton, PatternPreset } from "../common/preset-picker.slint";
import { ScrollArea } from "../common/scroll-area.slint";

// "Variable name" field for the Variable condition type: a free-typeable
// text input (unlike ComboBoxField, which is dropdown-only) with a
// discoverability affordance next to it — clicking the chevron (or the
// field itself) lists every named capture found across all triggers'
// Regex/Glob conditions (`discovered-names`, scanned live by Rust — see
// `triggers::engine::discover_named_vars`), still free-typeable for
// anything not on that list (e.g. a `store_var`-only name).
component VarNameField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <[string]> discovered-names;

    height: 30px;
    background: Theme.bg-elevated;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    animate border-color { duration: 100ms; }

    input := TextInput {
        x: Theme.space-sm;
        width: parent.width - 2 * Theme.space-sm - 18px;
        height: 100%;
        vertical-alignment: center;
        color: Theme.text-primary;
        font-size: Theme.font-size-md;
    }

    Text {
        x: parent.width - 20px;
        width: 14px;
        height: 100%;
        text: "\u{25BE}";
        color: Theme.text-secondary;
        font-size: Theme.font-size-sm;
        vertical-alignment: center;
    }

    chevron-touch := TouchArea {
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        height: min(max(root.discovered-names.length, 1) * 26px, 200px);

        Rectangle {
            background: Theme.bg-elevated;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border;

            ScrollArea {
                content-height: max(root.discovered-names.length, 1) * 26px;

                VerticalLayout {
                    if root.discovered-names.length == 0: HorizontalLayout {
                        height: 26px;
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        Text {
                            text: "No named captures found in your triggers yet";
                            color: Theme.text-disabled;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    for name in root.discovered-names: Rectangle {
                        height: 26px;
                        background: item-touch.has-hover ? Theme.bg-hover : transparent;

                        HorizontalLayout {
                            padding-left: Theme.space-sm;
                            padding-right: Theme.space-sm;
                            Text {
                                text: name;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        item-touch := TouchArea {
                            clicked => { root.text = name; }
                        }
                    }
                }
            }
        }
    }
}

// Edit body for a single trigger condition, embedded in the Settings
// drawer — was ConditionEditWindow (ui/dialogs/condition_edit_dialog.slint)
// before the drawer migration. Only ever pushed on top of an open
// TriggerPanel. Combo selections are kept as their displayed label strings
// (not indices); Rust maps label <-> enum on push/OK.
export component ConditionPanel inherits VerticalLayout {
    padding: Theme.space-lg;
    spacing: Theme.space-md;
    alignment: start;

    in-out property <string> cond-type: "Match (log line)";
    property <bool> is-match: root.cond-type == "Match (log line)";
    property <bool> is-chat: root.cond-type == "Chat message";
    property <bool> is-var: root.cond-type == "Variable";
    // Match and Chat both end in a match-type + pattern pair; Chat just
    // applies it to the chat message instead of the whole log line.
    property <bool> uses-pattern: root.is-match || root.is-chat;

    in-out property <string> match-type: "Regex";
    in-out property <string> pattern;
    // Log-line presets only make sense against the raw line (Match mode) —
    // Chat mode's pattern matches just the extracted message text, which
    // none of the built-in line patterns are shaped for.
    property <bool> show-presets: root.is-match && root.match-type == "Regex";
    in property <[PatternPreset]> pattern-presets;

    in-out property <string> chat-channel: "Any";
    property <bool> is-custom-channel: root.chat-channel == "Custom channel";
    in-out property <string> chat-custom-channel;

    in-out property <string> var-name;
    in-out property <string> var-op: "Is set";
    in-out property <string> var-value;
    in property <[string]> discovered-var-names;

    // Value's comparison source: "literal" (today's plain text, unchanged)
    // or "reference" (a `{name}` placeholder picked from the active
    // reference group's variables — see triggers.rs's `resolve_template`
    // call on a Var condition's `value`). Rust decides which on open (by
    // checking whether `var-value` is exactly a `{name}` placeholder) and
    // which to write back into `var-value`/`var-value-ref` on OK.
    in-out property <string> var-value-mode: "literal";
    in-out property <string> var-value-ref;
    in property <[string]> reference-var-options;
    // `isset` ignores Value entirely (see `Condition::Var`'s doc comment) —
    // dim the whole section rather than leave a control that does nothing.
    property <bool> value-relevant: root.var-op != "Is set";

    callback ok();
    callback cancel();

    LabeledField {
        label: "Condition type";
        ComboBoxField {
            options: ["Match (log line)", "Chat message", "Variable"];
            value <=> root.cond-type;
        }
    }

    Rectangle { height: 1px; background: Theme.border; }

    if root.is-chat: VerticalLayout {
        spacing: Theme.space-md;

        LabeledField {
            label: "Channel";
            ComboBoxField {
                options: [
                    "Any", "Say", "Tell", "OOC", "Shout",
                    "Guild", "Group", "Raid", "Auction", "Custom channel",
                ];
                value <=> root.chat-channel;
            }
        }
        if root.is-custom-channel: LabeledField {
            label: "Custom channel name";
            TextField {
                placeholder: "e.g. General:1 — matched loosely, by substring";
                text <=> root.chat-custom-channel;
            }
        }
    }

    if root.uses-pattern: VerticalLayout {
        spacing: Theme.space-md;

        LabeledField {
            label: "Match type";
            ComboBoxField {
                options: ["Exact (substring)", "Regex", "Glob  (* ? {name})"];
                value <=> root.match-type;
            }
        }
        VerticalLayout {
            spacing: Theme.space-xs;

            HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: root.is-chat ? "Message pattern (blank matches any message)" : "Pattern";
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.show-presets: PresetPickerButton {
                    presets: root.pattern-presets;
                    picked(p) => { root.pattern = p; }
                }
            }
            TextField {
                placeholder: root.is-chat
                    ? "e.g. help  or  (?P<item>.+) plz"
                    : "e.g. You have slain {target}!  or  (?P<name>.+) slain";
                text <=> root.pattern;
            }
        }
    }

    if root.is-var: VerticalLayout {
        spacing: Theme.space-md;

        HorizontalLayout {
            spacing: Theme.space-md;
            LabeledField {
                label: "Variable name";
                VarNameField {
                    text <=> root.var-name;
                    discovered-names: root.discovered-var-names;
                }
            }
            LabeledField {
                label: "Operator";
                ComboBoxField {
                    options: [
                        "Is set", "Equals", "Greater than", "Greater than or equal to",
                        "Less than", "Less than or equal to", "Contains", "Regex match",
                    ];
                    value <=> root.var-op;
                }
            }
        }

        VerticalLayout {
            spacing: Theme.space-xs;
            opacity: root.value-relevant ? 1.0 : 0.45;

            HorizontalLayout {
                spacing: Theme.space-sm;
                Text {
                    text: "Value";
                    color: Theme.text-secondary;
                    font-size: Theme.font-size-sm;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 160px;
                    height: 26px;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: Theme.radius-sm;
                    clip: true;

                    HorizontalLayout {
                        Rectangle {
                            background: root.var-value-mode == "literal" ? Theme.accent : Theme.bg-elevated;
                            Text {
                                text: "Literal";
                                color: root.var-value-mode == "literal" ? Theme.on-accent : Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                font-weight: root.var-value-mode == "literal" ? 700 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            TouchArea {
                                enabled: root.value-relevant;
                                clicked => { root.var-value-mode = "literal"; }
                            }
                        }
                        Rectangle {
                            background: root.var-value-mode == "reference" ? Theme.accent : Theme.bg-elevated;
                            Text {
                                text: "Reference";
                                color: root.var-value-mode == "reference" ? Theme.on-accent : Theme.text-secondary;
                                font-size: Theme.font-size-sm;
                                font-weight: root.var-value-mode == "reference" ? 700 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                            TouchArea {
                                enabled: root.value-relevant;
                                clicked => { root.var-value-mode = "reference"; }
                            }
                        }
                    }
                }
            }

            if root.var-value-mode == "literal": TextField {
                enabled: root.value-relevant;
                text <=> root.var-value;
            }
            if root.var-value-mode == "reference": ComboBoxField {
                enabled: root.value-relevant;
                options: root.reference-var-options;
                value <=> root.var-value-ref;
                placeholder: root.reference-var-options.length == 0
                    ? "No reference variables yet — add some in the Variables tab"
                    : "Select a reference variable";
                empty-message: "No reference variables yet — add some in the Variables tab";
            }
        }
    }

    Rectangle { vertical-stretch: 1; }

    HorizontalLayout {
        spacing: Theme.space-sm;
        alignment: end;
        Button { text: "Cancel"; primary: false; clicked => { root.cancel(); } }
        Button { text: "OK"; primary: true; clicked => { root.ok(); } }
    }
}
