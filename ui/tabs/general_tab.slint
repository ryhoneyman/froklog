import { Theme } from "../theme.slint";
import { Card } from "../common/card.slint";
import { Button } from "../common/buttons.slint";

// Phase 2.2 — replaces create_general_panel() in overlay_config_win.rs.
// Currently just spell icon import (sound volume/enabled actually live on
// the Sounds tab in the current code, despite the file's stale header
// comment claiming otherwise — verified against create_sounds_panel()).
export component GeneralTab inherits VerticalLayout {
    padding: Theme.space-lg;
    spacing: Theme.space-md;
    alignment: start;

    in property <string> import-status;
    in property <bool> import-in-progress;
    callback import-spell-icons();

    Text {
        text: "General";
        color: Theme.text-primary;
        font-size: Theme.font-size-xl;
        font-weight: 700;
    }

    Card {
        Text {
            text: "Spell Icon Import";
            color: Theme.text-primary;
            font-size: Theme.font-size-md;
            font-weight: 600;
        }
        Text {
            text: "Extracts spell icons from your EverQuest install so trigger actions can show them.";
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.space-sm;
            alignment: start;

            Button {
                text: root.import-in-progress ? "Extracting…" : "Import Spell Icons";
                enabled: !root.import-in-progress;
                clicked => { root.import-spell-icons(); }
            }
            Text {
                text: root.import-status;
                color: Theme.text-secondary;
                font-size: Theme.font-size-sm;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }
}
