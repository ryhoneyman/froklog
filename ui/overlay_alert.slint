import { Theme } from "theme.slint";
import { StrokedText } from "common/stroked-text.slint";
import { OverlayShell } from "common/overlay-shell.slint";

// Phase 3.1 — real alert overlay window, replacing overlay.rs's
// WS_EX_LAYERED + UpdateLayeredWindow popup. Deliberately NOT
// states/animate-driven like the Phase 0 spike (ui/spike_overlay.slint):
// the source's resolve_frame() already computes every per-frame value
// (font size, opacity, x/y offset) from the active phase/treatment,
// including continuous oscillations (Vibrate/Glow/Pulse) that Slint's
// `animate` block can't express — it interpolates once per state change,
// not a looping waveform — so Rust keeps driving that math unchanged on
// its existing 16ms timer, just targeting these properties instead of a
// GDI DIB. No background panel — only icon + stroked text render, fully
// transparent otherwise (matches the source, removed 2026-07-18 per user
// feedback, see project_gui_layout memory).
//
// Not implemented in this pass: drag-to-move (the source's
// WM_LBUTTONDOWN + WM_EXITSIZEMOVE position-save dance — the Windows
// tab's Position X/Y fields already cover repositioning without it).
//
// Width/height are a fixed, generous size (1200x260 — up from the
// original 780x140 that could clip a big configured font or long message,
// since this is a transparent no-frame window and anything past its own
// rectangle just doesn't render, no scroll/wrap fallback). Fixed, not
// content-driven: two different attempts at resizing this window
// per-frame to fit content exactly (tracking a fixed on-screen anchor and
// recentering around it as width changed) each shipped, got tested on a
// real Windows machine, and turned out to still drift/fight the window's
// own drag-to-move — resizing a *native* top-level window every ~16ms and
// reading its resulting geometry back synchronously enough to recenter
// perfectly, every frame, without racing the OS's own drag-move loop,
// wasn't reliable in practice. This window's actual content (`wrap`
// below) already centers itself correctly within a *fixed*-size window on
// its own, via ordinary `x: (parent.width - self.width) / 2` — the
// original design, and the one part of this that was never actually
// broken. If 1200x260 ever proves too small for someone's configured font/
// message combination, grow these two numbers; don't reintroduce
// per-frame native resizing.
export component AlertOverlayWindow inherits OverlayShell {
    title: "Alert Overlay";
    width: 1200px;
    height: 260px;

    in property <string> message;
    in property <image> icon-source;
    in property <bool> has-icon;
    in property <color> text-color: white;
    in property <color> stroke-color: black;

    // Per-frame values, all computed in Rust from resolve_frame()'s math —
    // see overlay.rs: FlyIn eases start-pt -> max-pt / alpha 0 -> 1 / rises
    // RISE_PX; Hold applies the active Treatment (glow pulse, vibrate
    // jitter, or pulse-sized wobble); ShrinkOut reverses FlyIn's easing
    // while translating toward the history window's anchor.
    in property <float> font-size-pt: 10;
    in property <float> alpha: 0;
    in property <length> x-offset: 0px;
    in property <length> y-offset: 0px;
    in property <bool> glow: false;
    in property <float> glow-pulse: 0;

    // Stroke width scales with font size, matching
    // `(font_pt / 20.0).round().clamp(1, 3)` in the source.
    property <length> stroke-w: max(1px, min(3px, root.font-size-pt / 20 * 1px));

    // Drag-to-move: this window has no native title bar (no-frame: true),
    // so there's nothing to drag by except a TouchArea we drive ourselves.
    // Covers the full window (not just the message, which may be much
    // smaller than the window and moves/resizes itself) so there's a large
    // grab target — most relevant while positioning the "Show All Windows"
    // placeholder, which sits centered in an otherwise-transparent window.
    // Rust hands the press off to the OS's own interactive-move loop
    // (winit's `drag_window`) rather than tracking mouse deltas and calling
    // `set_position` ourselves — the latter causes a feedback loop (moving
    // the window changes what "mouse position relative to the window"
    // means, which re-triggers another move) that reads as jittering.
    // See common/overlay-shell.slint's doc comment for why this trio can't
    // just be inherited from `OverlayShell` like the window-level flags.
    in property <bool> locked: false;
    // "Locked" means click-through during normal play, not "unmovable
    // forever" — while Show All Windows is active (this app's dedicated
    // positioning mode), dragging works regardless of Locked, since that's
    // exactly when a user wants to grab and reposition every overlay,
    // locked ones included.
    in property <bool> force-show: false;
    callback drag-requested();

    // Linux-only escape hatch (set once at window creation in overlay.rs,
    // never toggled at runtime): this window's "transparent" background
    // relies on the OS actually compositing per-pixel alpha for a
    // top-level window, which X11 without a running compositor doesn't do
    // — the whole 1200x260 canvas then shows as opaque black instead of
    // see-through, silently swallowing the icon+text drawn on top of it.
    // Windows' DWM always composites, so this stays false there and the
    // window looks exactly as before. Doesn't touch window width/height
    // (that stays fixed everywhere, matching real alerts) — only adds a
    // real, appropriately-sized backing behind the message so it's
    // legible even when the surrounding margin can't actually be made
    // to disappear.
    in property <bool> panel-fallback: false;

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: !root.locked || root.force-show;
        changed pressed => {
            if self.pressed {
                root.drag-requested();
            }
        }
    }

    Rectangle {
        x: root.x-offset;
        y: (parent.height - self.height) / 2 + root.y-offset;
        width: parent.width;
        height: wrap.height;
        opacity: root.alpha;

        // Sized to the row's own natural content (icon + gap + text), not
        // the full window width, and centered within it — the glow halo
        // below is sized off this, not off the icon alone, so it wraps
        // the whole message rather than just the icon (deliberately
        // different from the source, which centers glow on the icon
        // only — a UX refinement made during this port, not a parity bug).
        wrap := Rectangle {
            x: (parent.width - self.width) / 2;
            width: row.preferred-width;
            height: row.preferred-height;

            if root.panel-fallback: Rectangle {
                x: -16px;
                y: -10px;
                width: parent.width + 32px;
                height: parent.height + 20px;
                border-radius: 10px;
                background: #0c0c11e6;
            }

            if root.glow: Rectangle {
                x: -10px;
                y: -10px;
                width: parent.width + 20px;
                height: parent.height + 20px;
                border-radius: 16px;
                background: root.text-color;
                opacity: root.glow-pulse * 0.35;
            }

            row := HorizontalLayout {
                width: 100%;
                height: 100%;
                spacing: 14px;
                alignment: center;

                if root.has-icon: Image {
                    source: root.icon-source;
                    // Roughly matches the text's cap-height rather than
                    // the source's larger `icon_sz` (icon_sz ~= 1.6x the
                    // font size) — another deliberate UX refinement.
                    width: root.font-size-pt * 1px;
                    height: root.font-size-pt * 1px;
                    image-fit: contain;
                }

                StrokedText {
                    text: root.message;
                    text-color: root.text-color;
                    stroke-color: root.stroke-color;
                    stroke-width: root.stroke-w;
                    font-size: root.font-size-pt * 1px;
                }
            }
        }
    }
}
