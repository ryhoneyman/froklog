import { Theme } from "../theme.slint";

// Replaces Win32 BS_AUTORADIOBUTTON groups (mk_child with WS_GROUP), e.g.
// the Voice tab's Audio Mode selector.
export component RadioGroup inherits VerticalLayout {
    in property <[string]> options;
    in-out property <int> selected: 0;

    spacing: Theme.space-sm;

    for opt[i] in root.options: Rectangle {
        height: 22px;

        HorizontalLayout {
            spacing: Theme.space-sm;

            dot := Rectangle {
                width: 18px;
                height: 18px;
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: root.selected == i ? Theme.accent : Theme.border;
                background: Theme.bg-elevated;

                animate border-color { duration: 100ms; }

                Rectangle {
                    visible: root.selected == i;
                    width: 10px;
                    height: 10px;
                    border-radius: self.width / 2;
                    background: Theme.accent;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Text {
                text: opt;
                color: Theme.text-primary;
                font-size: Theme.font-size-md;
                vertical-alignment: center;
            }
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.selected = i; }
        }
    }
}
