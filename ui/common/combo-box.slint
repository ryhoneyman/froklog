import { Theme } from "../theme.slint";
import { ScrollArea } from "scroll-area.slint";

// Themed dropdown, replacing Win32 CB_DROPDOWNLIST controls (mk_combo).
export component ComboBoxField inherits Rectangle {
    in property <[string]> options;
    in-out property <string> value;
    in property <string> placeholder;
    in property <bool> enabled: true;
    // Shown as the popup's only row when `options` is empty, instead of an
    // empty (and therefore effectively invisible) popup — a combo backed by
    // a fallible async source (e.g. the Voice tab's TTS voice list) can
    // legitimately have zero options, and with no row at all, clicking it
    // looks indistinguishable from the dropdown being broken.
    in property <string> empty-message: "No options available";

    callback selected(string);

    property <length> item-height: 28px;
    // Some backends (e.g. Linux speech-dispatcher/espeak voice lists) can
    // hand back hundreds of options — an unbounded VerticalLayout would
    // size the popup to fit all of them, which on the software renderer's
    // 16-bit physical-pixel coordinates overflows and panics well before
    // that. Cap the popup and let it scroll instead.
    property <length> list-height: root.options.length == 0 ? root.item-height : min(root.options.length * root.item-height, 240px);

    height: 30px;
    background: root.enabled ? Theme.bg-elevated : Theme.bg-panel;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.border;

    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;

        Text {
            text: root.value == "" ? root.placeholder : root.value;
            color: root.value == "" || !root.enabled ? Theme.text-disabled : Theme.text-primary;
            font-size: Theme.font-size-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Text {
            text: "\u{25be}";
            color: Theme.text-secondary;
            font-size: Theme.font-size-sm;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: root.width;
        height: root.list-height;

        Rectangle {
            background: Theme.bg-elevated;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border;

            ScrollArea {
                content-height: max(root.options.length, 1) * root.item-height;

                VerticalLayout {
                    if root.options.length == 0: HorizontalLayout {
                        height: root.item-height;
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        Text {
                            text: root.empty-message;
                            color: Theme.text-disabled;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    for opt in root.options: Rectangle {
                        height: root.item-height;
                        background: item-touch.has-hover ? Theme.bg-hover : transparent;

                        HorizontalLayout {
                            padding-left: Theme.space-sm;
                            padding-right: Theme.space-sm;
                            Text {
                                text: opt;
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        item-touch := TouchArea {
                            clicked => {
                                root.value = opt;
                                root.selected(opt);
                            }
                        }
                    }
                }
            }
        }
    }
}
