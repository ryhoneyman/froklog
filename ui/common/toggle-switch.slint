import { Theme } from "../theme.slint";

// iOS/Material-style sliding toggle, replacing Checkbox for the overlay
// cards' master Enabled control (see SettingsCard in card.slint).
export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;

    width: 40px;
    height: 22px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.accent : Theme.bg-elevated;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1.0 : 0.5;

    animate background, border-color { duration: 150ms; }

    knob := Rectangle {
        width: 16px;
        height: 16px;
        y: (parent.height - self.height) / 2;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        border-radius: self.height / 2;
        background: Theme.on-accent;

        animate x { duration: 150ms; easing: ease-out; }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.checked = !root.checked; }
    }
}
