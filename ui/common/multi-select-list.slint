import { Theme } from "../theme.slint";
import { ScrollArea } from "scroll-area.slint";

// Replaces the Win32 LBS_MULTIPLESEL listbox used for the action editor's
// sound picker. `selected` is a plain bool array parallel to `items` (not
// an index set) since Slint has no Set type — Rust owns the source of
// truth and flips one entry per `toggle(index)` call, same division of
// labor as the other list widgets here (ListBox, RadioGroup).
export component MultiSelectList inherits Rectangle {
    in property <[string]> items;
    in property <[bool]> selected;
    callback toggle(int);

    background: Theme.bg-elevated;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    ScrollArea {
        content-height: content.preferred-height;

        content := VerticalLayout {
            for item[i] in root.items: Rectangle {
                height: 26px;
                background: touch.has-hover ? Theme.bg-hover : transparent;

                HorizontalLayout {
                    padding-left: Theme.space-sm;
                    spacing: Theme.space-sm;

                    box := Rectangle {
                        width: 14px;
                        height: 14px;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: root.selected[i] ? Theme.accent : Theme.border;
                        background: root.selected[i] ? Theme.accent : Theme.bg-panel;

                        Text {
                            visible: root.selected[i];
                            text: "✓";
                            color: Theme.on-accent;
                            font-size: 10px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    Text {
                        text: item;
                        color: Theme.text-primary;
                        font-size: Theme.font-size-sm;
                        vertical-alignment: center;
                    }
                }

                touch := TouchArea {
                    clicked => { root.toggle(i); }
                }
            }
        }
    }
}
