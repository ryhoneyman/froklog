    { "category": "Combat", "label": "You melee a target", "pattern": "You (?:hit|slash|crush|pierce|bash|kick|punch|backstab)s? (?P<tgt>.+?) for (?P<dmg>\\d+) point" },
    { "category": "Combat", "label": "Something melees you", "pattern": "(?P<src>.+?) (?:hits?|slashes?|crushes?|pierces?|bites?|claws?) YOU for (?P<dmg>\\d+) point" },
    { "category": "Combat", "label": "Spell damage lands", "pattern": "(?P<src>.+?)'s (?P<spell>.+?) (?:hit|has taken effect on) (?P<tgt>.+?)(?: for (?P<dmg>\\d+) point)?" },
