    { "category": "Chat", "label": "Someone says something", "pattern": "(?P<src>.+?) says?, '(?P<msg>.+)'" },
    { "category": "Chat", "label": "Someone tells the group", "pattern": "(?P<src>.+?) tells? the group, '(?P<msg>.+)'" },
    { "category": "Loot", "label": "You loot an item", "pattern": "You (?:have )?looted (?P<item>.+?) from (?P<mob>.+?)'s corpse" },
    { "category": "Loot", "label": "You receive currency from a corpse", "pattern": "You receive (?P<amounts>.+?) from the corpse\\." },
    { "category": "System", "label": "You enter a zone", "pattern": "You have entered (?P<zone>.+)\\." }
